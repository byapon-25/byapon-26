{% extends "base.html" %}
{% block content %}

<h1>Edit Student</h1>

<div class="card">

<form method="post" class="grid">

<input
name="student_id"
value="{{student.student_id}}"
required
>

<input
name="name"
value="{{student.name}}"
required
>

<input
name="phone"
value="{{student.phone or ''}}"
>

<input
name="guardian"
value="{{student.guardian or ''}}"
>

<input
name="class_name"
value="{{student.class_name or ''}}"
>

<input
name="batch"
value="{{student.batch or ''}}"
>

<input
name="monthly_fee"
type="number"
value="{{student.monthly_fee}}"
>

<input
name="password"
placeholder="New password (optional)"
>

<button class="btn primary">
SAVE CHANGES
</button>

</form>

</div>

{% endblock %}
