{% extends "base.html" %}
{% block content %}

<h1>Edit Teacher</h1>

<div class="card">

<form method="post" class="grid">

<input
name="name"
value="{{teacher.name}}"
required
>

<input
name="phone"
value="{{teacher.phone or ''}}"
>

<input
name="subject"
value="{{teacher.subject or ''}}"
>

<input
name="salary"
type="number"
value="{{teacher.salary}}"
>

<button class="btn primary">
SAVE CHANGES
</button>

</form>

</div>

{% endblock %}
