{% extends "base.html" %}
{% block content %}

<h1>Student Fees</h1>

<div class="card">

<form method="post" class="grid">

<select name="student_id" required>

<option value="">
Select Student
</option>

{% for s in students %}

<option value="{{s.id}}">
{{s.name}} — {{s.student_id}}
</option>

{% endfor %}

</select>

<input
name="fee_month"
placeholder="Month"
required
>

<input
name="amount"
type="number"
step="0.01"
placeholder="Total Fee"
required
>

<input
name="paid_amount"
type="number"
step="0.01"
placeholder="Paid Amount"
>

<input
name="payment_date"
type="date"
>

<input
name="note"
placeholder="Note"
>

<button class="btn primary">
SAVE FEE
</button>

</form>

</div>

<div class="card tablewrap">

<table>

<tr>
<th>Student</th>
<th>Month</th>
<th>Amount</th>
<th>Paid</th>
<th>Status</th>
<th>Action</th>
</tr>

{% for f in fees %}

<tr>

<td>{{f.name}}</td>

<td>{{f.fee_month}}</td>

<td>৳{{f.amount}}</td>

<td>৳{{f.paid_amount}}</td>

<td>{{f.status}}</td>

<td>

<form
method="post"
action="/fees/{{f.id}}/delete"
>

<button class="danger">
Delete
</button>

</form>

</td>

</tr>

{% endfor %}

</table>

</div>

{% endblock %}
