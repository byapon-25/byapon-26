/* =========================================================
   BYAPON CMS — PREMIUM BRIGHT FORM UI
   White + Royal Blue + Yellow
   ========================================================= */

:root{
    --pf-blue:#155eef;
    --pf-blue-dark:#0b3b91;
    --pf-blue-light:#eef5ff;
    --pf-yellow:#ffc928;
    --pf-yellow-light:#fff8d8;
    --pf-white:#ffffff;
    --pf-bg:#f5f9ff;
    --pf-text:#172033;
    --pf-muted:#64748b;
    --pf-border:#dbe5f2;
    --pf-shadow:0 18px 50px rgba(21,94,239,.10);
}

/* Bright overall background */
body{
    background:
        radial-gradient(circle at 5% 5%, rgba(255,201,40,.16), transparent 25%),
        radial-gradient(circle at 95% 10%, rgba(21,94,239,.10), transparent 28%),
        linear-gradient(135deg,#ffffff 0%,#f7faff 48%,#eef5ff 100%) !important;
    color:var(--pf-text);
}

/* Form containers / cards */
form{
    background:var(--pf-white);
    border:1px solid var(--pf-border);
    border-radius:22px;
    padding:28px;
    box-shadow:var(--pf-shadow);
    position:relative;
    overflow:hidden;
    margin-bottom:25px;
}

form:before{
    content:"";
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:5px;
    background:linear-gradient(90deg,
        var(--pf-blue-dark),
        var(--pf-blue),
        var(--pf-yellow),
        var(--pf-blue)
    );
}

/* Headings near forms */
form h1,
form h2,
form h3{
    color:var(--pf-blue-dark);
    font-weight:850;
    letter-spacing:-.3px;
}

form h1:after,
form h2:after,
form h3:after{
    content:"";
    display:block;
    width:48px;
    height:4px;
    border-radius:10px;
    background:var(--pf-yellow);
    margin-top:8px;
}

/* Labels */
form label{
    display:block;
    color:#26344d;
    font-size:13px;
    font-weight:800;
    margin:16px 0 7px;
}

/* Inputs */
form input,
form select,
form textarea{
    width:100%;
    box-sizing:border-box;
    background:#fbfdff !important;
    color:var(--pf-text) !important;
    border:1.5px solid var(--pf-border) !important;
    border-radius:13px !important;
    padding:13px 15px !important;
    min-height:48px;
    outline:none;
    font-size:14px;
    font-weight:550;
    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease,
        transform .2s ease;
}

form textarea{
    min-height:110px;
    resize:vertical;
}

form input::placeholder,
form textarea::placeholder{
    color:#94a3b8;
}

/* Premium focus */
form input:focus,
form select:focus,
form textarea:focus{
    background:#fff !important;
    border-color:var(--pf-blue) !important;
    box-shadow:
        0 0 0 4px rgba(21,94,239,.10),
        0 8px 20px rgba(21,94,239,.08);
    transform:translateY(-1px);
}

/* Checkbox */
form input[type="checkbox"]{
    width:18px !important;
    min-height:18px;
    accent-color:var(--pf-blue);
    transform:none;
}

/* Radio */
form input[type="radio"]{
    width:18px !important;
    min-height:18px;
    accent-color:var(--pf-blue);
    transform:none;
}

/* Buttons */
form button,
form input[type="submit"],
form input[type="button"]{
    border:0 !important;
    border-radius:13px !important;
    padding:13px 23px !important;
    min-height:46px;
    background:linear-gradient(135deg,#155eef,#0b3b91) !important;
    color:#fff !important;
    font-weight:850 !important;
    font-size:14px;
    cursor:pointer;
    box-shadow:0 9px 22px rgba(21,94,239,.20);
    transition:all .2s ease;
    margin-top:18px;
}

form button:hover,
form input[type="submit"]:hover,
form input[type="button"]:hover{
    transform:translateY(-2px);
    box-shadow:0 13px 28px rgba(21,94,239,.27);
}

/* Add / Save / Update emphasis */
form button[type="submit"]{
    background:linear-gradient(135deg,#155eef,#0b3b91) !important;
}

/* Cancel / secondary links */
form a{
    display:inline-block;
    text-decoration:none;
    color:var(--pf-blue-dark);
    background:var(--pf-blue-light);
    border:1px solid #cfe0ff;
    border-radius:12px;
    padding:11px 18px;
    font-weight:800;
    margin:18px 5px 0 0;
    transition:.2s ease;
}

form a:hover{
    background:var(--pf-yellow-light);
    border-color:#f1d15b;
    transform:translateY(-1px);
}

/* Form rows */
.form-row{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:18px;
}

/* Field groups */
.form-group{
    margin-bottom:5px;
}

/* Cards commonly used around forms */
.card,
.form-card,
.admin-card{
    background:#fff;
    border:1px solid var(--pf-border);
    border-radius:20px;
    box-shadow:var(--pf-shadow);
}

/* Tables stay bright */
table{
    background:#fff;
    border-radius:16px;
    overflow:hidden;
}

th{
    background:linear-gradient(135deg,#0b3b91,#155eef) !important;
    color:#fff !important;
}

tr:nth-child(even){
    background:#f8fbff;
}

/* Bright section headers */
.page-title,
.section-title{
    color:var(--pf-blue-dark);
    font-weight:900;
}

/* Mobile */
@media(max-width:700px){

    form{
        padding:20px 17px;
        border-radius:18px;
        margin:12px 5px 20px;
    }

    .form-row{
        grid-template-columns:1fr;
        gap:5px;
    }

    form input,
    form select,
    form textarea{
        font-size:16px !important;
        min-height:50px;
    }

    form button,
    form input[type="submit"],
    form input[type="button"]{
        width:100%;
        margin-top:14px;
    }

    form a{
        text-align:center;
        width:100%;
        box-sizing:border-box;
        margin-top:10px;
    }
}

/* Print protection */
@media print{
    form{
        box-shadow:none !important;
        background:#fff !important;
    }
}
